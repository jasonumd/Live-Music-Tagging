lumn index="1" value="119"/><column index="2" value="83"/><column index="3" value="139"/><column index="4" value="35"/><column index="5" value="41"/></column_widths><filter_values><column index="2" value="2953"/></filter_values><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="events" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="0" mode="1"/></sort><column_widths><column index="1" value="90"/><column index="2" value="45"/><column index="3" value="61"/><column index="4" value="39"/><column index="5" value="44"/><column index="6" value="35"/><column index="7" value="60"/></column_widths><filter_values><column index="0" value="36"/></filter_values><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="songs" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="0" mode="1"/></sort><column_widths><column index="1" value="39"/><column index="2" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">SELECT
    acts.name,
    event_sets.&quot;set&quot;,
    events.Year,
    events.Month,
    events.Day,
    venues.venue1,
    venues.venue2,
    venues.venue3,
    venues.venue4
FROM
    venues
    INNER JOIN (
        (
            acts
            INNER JOIN events ON acts.ID = events.act_id
        )
        INNER JOIN event_sets ON events.ID = event_sets.event_id
    ) ON venues.ID = events.venue_id
WHERE
    (
        ((acts.name) = &quot;Widespread Panic&quot;)
        AND ((event_sets.&quot;set&quot;) = &quot;E2&quot;)
    )
ORDER BY
    events.Year,
    events.Month,
    events.Day;</sql><current_tab id="0"/></tab_sql></sqlb_project>
