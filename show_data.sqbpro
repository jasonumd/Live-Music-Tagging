ex="1" value="167"/><column index="2" value="85"/><column index="3" value="54"/><column index="4" value="35"/><column index="5" value="42"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="events" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="39"/><column index="2" value="45"/><column index="3" value="61"/><column index="4" value="39"/><column index="5" value="44"/><column index="6" value="29"/><column index="7" value="60"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="songs" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="0" mode="0"/></sort><column_widths><column index="1" value="39"/><column index="2" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="venues" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="0" mode="0"/></sort><column_widths><column index="1" value="39"/><column index="2" value="300"/><column index="3" value="263"/><column index="4" value="207"/><column index="5" value="103"/><column index="6" value="50"/></column_widths><filter_values><column index="1" value="hard rock"/></filter_values><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 2">SELECT acts.name,
                   events.Year, events.Month, events.Day,
                   venues.venue1, venues.venue2, venues.venue3, venues.venue4, venues.venue5,
                   event_sets.&quot;set&quot;, songs.song, event_songs.segue
            FROM venues
            INNER JOIN (songs
                INNER JOIN ((acts
                    INNER JOIN events ON acts.ID = events.act_id)
                    INNER JOIN (event_sets
                        INNER JOIN event_songs ON event_sets.id = event_songs.event_set_id)
                    ON events.ID = event_sets.event_id)
                ON songs.ID = event_songs.song_id)
            ON venues.ID = events.venue_id
            WHERE events.Year = 1983 AND events.Month = 1 AND events.Day = 24
                AND acts.name_search = 'Jerry Garcia' AND events.event_no = 1
            ORDER BY event_sets.seq, event_songs.seq, events.event_no;</sql><sql name="SQL 2">SELECT acts.name,
       events.Year, events.Month, events.Day,
       venues.venue1, venues.venue2, venues.venue3, venues.venue4, venues.venue5,
       event_sets.&quot;set&quot;, songs.song, event_songs.segue
FROM events
INNER JOIN acts ON acts.ID = events.act_id
INNER JOIN venues ON venues.ID = events.venue_id
LEFT JOIN event_sets ON events.ID = event_sets.event_id
LEFT JOIN event_songs ON event_sets.id = event_songs.event_set_id
LEFT JOIN songs ON songs.ID = event_songs.song_id
WHERE events.Year = 1983 AND events.Month = 1 AND events.Day = 24
    AND acts.name_search = 'Grateful Dead'
ORDER BY event_sets.seq, event_songs.seq, events.event_no;</sql><sql name="SQL 3">SELECT 
    gd.year, gd.month, gd.day,
    gd.id AS gd_event_id,
    jg.id AS jg_event_id,
    v1.venue1 AS gd_venue,
    v2.venue1 AS jg_venue
FROM events gd
INNER JOIN acts a1 ON gd.act_id = a1.id
INNER JOIN events jg ON gd.year = jg.year 
                     AND gd.month = jg.month 
                     AND gd.day = jg.day
INNER JOIN acts a2 ON jg.act_id = a2.id
LEFT JOIN venues v1 ON gd.venue_id = v1.id
LEFT JOIN venues v2 ON jg.venue_id = v2.id
WHERE a1.name_search = 'Grateful Dead'
  AND a2.name_search = 'Jerry Garcia'
ORDER BY gd.year, gd.month, gd.day;</sql><current_tab id="0"/></tab_sql></sqlb_project>
